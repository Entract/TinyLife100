{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tl100.local/schemas/dependency_boundary.schema.json",
  "title": "TL100 Glass-Box Dependency Boundary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "boundary_id", "component", "version", "license", "function", "inputs", "outputs", "behavior", "relevant_defaults", "overridden_defaults", "known_limitations", "scientific_effects", "test_refs", "decision_owner", "reviewed_at", "content_hash"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "boundary_id": {"$ref": "common.schema.json#/$defs/boundary_id"},
    "component": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "function": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "outputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "behavior": {"type": "string", "enum": ["deterministic", "conditionally_deterministic", "nondeterministic"]},
    "relevant_defaults": {"type": "array", "items": {"type": "string"}},
    "overridden_defaults": {"type": "array", "items": {"type": "string"}},
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "scientific_effects": {"type": "array", "items": {"type": "string"}},
    "test_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "decision_owner": {"type": "string", "minLength": 1},
    "reviewed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "content_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
