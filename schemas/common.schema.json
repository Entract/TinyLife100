{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tl100.local/schemas/common.schema.json",
  "title": "TL100 Design v3 Common Definitions",
  "$defs": {
    "schema_version": {
      "type": "string",
      "const": "3.0.0"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "canonical_status": {
      "type": "string",
      "enum": ["draft", "under_review", "accepted", "rejected", "superseded", "withdrawn_before_release"]
    },
    "node_id": {
      "type": "string",
      "pattern": "^node_[a-z0-9][a-z0-9_-]*$"
    },
    "edge_id": {
      "type": "string",
      "pattern": "^edge_[a-z0-9][a-z0-9_-]*$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^ent_[a-z0-9][a-z0-9_-]*$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^claim_[a-z0-9][a-z0-9_-]*$"
    },
    "concept_id": {
      "type": "string",
      "pattern": "^concept_[a-z0-9][a-z0-9_-]*$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^source_[a-z0-9][a-z0-9_-]*$"
    },
    "segment_id": {
      "type": "string",
      "pattern": "^segment_[a-z0-9][a-z0-9_-]*$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact_[a-z0-9][a-z0-9_-]*$"
    },
    "delta_id": {
      "type": "string",
      "pattern": "^delta_[a-z0-9][a-z0-9_-]*$"
    },
    "state_id": {
      "type": "string",
      "pattern": "^state_[a-z0-9][a-z0-9_-]*$"
    },
    "stream_item_id": {
      "type": "string",
      "pattern": "^stream_[a-z0-9][a-z0-9_-]*$"
    },
    "question_id": {
      "type": "string",
      "pattern": "^question_[a-z0-9][a-z0-9_-]*$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^release_[a-z0-9][a-z0-9._-]*$"
    },
    "export_id": {
      "type": "string",
      "pattern": "^export_[a-z0-9][a-z0-9._-]*$"
    },
    "replacement_id": {
      "type": "string",
      "pattern": "^replace_[a-z0-9][a-z0-9._-]*$"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^receipt_[a-z0-9][a-z0-9._-]*$"
    },
    "validation_report_id": {
      "type": "string",
      "pattern": "^validation_[a-z0-9][a-z0-9._-]*$"
    },
    "tokenizer_id": {
      "type": "string",
      "pattern": "^tokenizer_[a-z0-9][a-z0-9._-]*$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^decision_[a-z0-9][a-z0-9._-]*$"
    },
    "boundary_id": {
      "type": "string",
      "pattern": "^boundary_[a-z0-9][a-z0-9._-]*$"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^protocol_[a-z0-9][a-z0-9._-]*$"
    },
    "record_kind": {
      "type": "string",
      "enum": ["node", "relation_edge", "entity", "claim", "concept", "source", "source_segment", "artifact", "state_delta", "state_snapshot", "stream_item", "replacement", "acceptance_receipt", "release_manifest", "export_manifest", "validation_report", "tokenizer_manifest", "decision_record", "dependency_boundary"]
    },
    "acquisition_mode": {
      "type": "string",
      "enum": ["observation", "measurement", "conversation", "source_reading", "artifact_inspection", "experiment", "inference", "explanation_or_teaching", "prior_assumption", "correction"]
    },
    "claim_availability": {
      "type": "string",
      "enum": ["unavailable", "available_but_unattended", "encountered", "partially_processed", "available_through_reference"]
    },
    "claim_stance": {
      "type": "string",
      "enum": ["no_recorded_stance", "hypothesized", "uncertain", "tentatively_accepted", "accepted", "rejected", "superseded", "intentionally_unresolved"]
    },
    "confidence_category": {
      "type": "string",
      "enum": ["low", "medium", "high", "not_recorded"]
    },
    "concept_exposure": {
      "type": "string",
      "enum": ["not_exposed", "exposed"]
    },
    "competence": {
      "type": "string",
      "enum": ["not_exposed", "exposed", "recognized_with_support", "applied_with_support", "applied_independently", "explained_accurately", "transferred", "contradicted_by_assessment"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "created_by", "origin"],
      "properties": {
        "created_at": {"$ref": "#/$defs/timestamp"},
        "created_by": {"type": "string", "minLength": 1},
        "origin": {
          "type": "string",
          "enum": ["project_human", "project_model_assisted", "project_generated", "external_human", "external_model", "mixed", "derived"]
        },
        "tool_name": {"type": ["string", "null"]},
        "tool_version": {"type": ["string", "null"]},
        "model_id": {"type": ["string", "null"]},
        "prompt_hashes": {
          "type": "array",
          "items": {"$ref": "#/$defs/sha256"},
          "uniqueItems": true
        },
        "grounding_record_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "parent_record_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "deterministic_seed": {"type": ["integer", "null"], "minimum": 0},
        "notes": {"type": ["string", "null"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reviewers", "decided_at", "notes"],
      "properties": {
        "decision": {"type": "string", "enum": ["pending", "accepted", "rejected"]},
        "reviewers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "decided_at": {
          "oneOf": [
            {"$ref": "#/$defs/timestamp"},
            {"type": "null"}
          ]
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "record_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_kind", "record_id", "content_hash"],
      "properties": {
        "record_kind": {"$ref": "#/$defs/record_kind"},
        "record_id": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "file_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "media_type", "byte_count", "content_hash", "record_schema_id", "record_count"],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-][A-Za-z0-9._/-]*$"
        },
        "media_type": {"type": "string", "minLength": 1},
        "byte_count": {"type": "integer", "minimum": 0},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "record_schema_id": {"type": ["string", "null"], "format": "uri"},
        "record_count": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "tensor_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "encoding", "semantics_version", "dtype", "shape", "endianness"],
      "properties": {
        "file": {"$ref": "#/$defs/file_artifact"},
        "encoding": {"type": "string", "minLength": 1},
        "semantics_version": {"type": "string", "minLength": 1},
        "dtype": {"type": "string", "enum": ["bool", "uint8", "uint16", "uint32", "uint64", "int8", "int16", "int32", "int64", "float16", "bfloat16", "float32", "float64"]},
        "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 1},
        "endianness": {"type": "string", "enum": ["little", "big", "not_applicable"]}
      }
    },
    "tool_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "git_commit", "configuration_hash", "environment_hash"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "configuration_hash": {"$ref": "#/$defs/sha256"},
        "environment_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
