{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tl100.local/schemas/acceptance_receipt.schema.json",
  "title": "TL100 Design v3 Atomic Acceptance Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "bundle_id", "accepted_at", "accepted_by", "store_version", "previous_canonical_head_hash", "new_canonical_head_hash", "accepted_records", "stream_item_id", "pre_state_hash", "post_state_hash", "validation_report_id", "validation_report_hash", "review_record_hashes", "transaction_hash", "content_hash"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "receipt_id": {"$ref": "common.schema.json#/$defs/receipt_id"},
    "bundle_id": {"type": "string", "pattern": "^bundle_[a-z0-9][a-z0-9._-]*$"},
    "accepted_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "accepted_by": {"type": "string", "minLength": 1},
    "store_version": {"type": "string", "minLength": 1},
    "previous_canonical_head_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "new_canonical_head_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "accepted_records": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/record_ref"}, "minItems": 1},
    "stream_item_id": {"$ref": "common.schema.json#/$defs/stream_item_id"},
    "pre_state_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "post_state_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "validation_report_id": {"$ref": "common.schema.json#/$defs/validation_report_id"},
    "validation_report_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "review_record_hashes": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/sha256"}, "minItems": 1, "uniqueItems": true},
    "transaction_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "content_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
