{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tl100.local/schemas/stream_item.schema.json",
  "title": "TL100 Design v3 Canonical Stream Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stream_item_id", "canonical_stream_id", "ordinal", "simultaneous_group_id", "node_id", "state_before_hash", "state_after_hash", "emits_canonical_payload", "canonical_status", "content_hash"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "stream_item_id": {"$ref": "common.schema.json#/$defs/stream_item_id"},
    "canonical_stream_id": {"type": "string", "pattern": "^canonical_[a-z0-9][a-z0-9._-]*$"},
    "ordinal": {"type": "integer", "minimum": 0},
    "simultaneous_group_id": {"type": ["string", "null"], "pattern": "^group_[a-z0-9][a-z0-9_-]*$"},
    "node_id": {"$ref": "common.schema.json#/$defs/node_id"},
    "state_before_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "state_after_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "emits_canonical_payload": {"type": "boolean"},
    "canonical_status": {"$ref": "common.schema.json#/$defs/canonical_status"},
    "content_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
