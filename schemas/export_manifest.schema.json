{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tl100.local/schemas/export_manifest.schema.json",
  "title": "TL100 Design v3 Export Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "export_id", "release_id", "created_at", "compiler", "tokenizer", "selection", "context_policy", "update_order_policy", "relationship_visibility", "source_policy", "items", "token_accounting", "output", "manifest_hash"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "export_id": {"$ref": "common.schema.json#/$defs/export_id"},
    "release_id": {"$ref": "common.schema.json#/$defs/release_id"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "git_commit", "configuration_hash", "normalization_policy_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "configuration_hash": {"$ref": "common.schema.json#/$defs/sha256"},
        "normalization_policy_version": {"type": "string", "minLength": 1}
      }
    },
    "tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "configuration_hash", "vocabulary_hash"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "configuration_hash": {"$ref": "common.schema.json#/$defs/sha256"},
        "vocabulary_hash": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_stream_id", "selected_stream_item_ids", "derived_payload_ids", "selection_hash"],
      "properties": {
        "canonical_stream_id": {"type": "string", "pattern": "^canonical_[a-z0-9][a-z0-9._-]*$"},
        "selected_stream_item_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/stream_item_id"}, "uniqueItems": true},
        "derived_payload_ids": {"type": "array", "items": {"type": "string", "pattern": "^derived_[a-z0-9][a-z0-9_-]*$"}, "uniqueItems": true},
        "selection_hash": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["related_items_share_context", "grouping_method", "max_context_tokens", "boundary_token_ids", "cross_group_attention"],
      "properties": {
        "related_items_share_context": {"type": "boolean"},
        "grouping_method": {"type": "string", "enum": ["canonical_node", "same_stream_group", "relation_components", "fixed_token_windows", "custom"]},
        "max_context_tokens": {"type": "integer", "minimum": 1},
        "boundary_token_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "cross_group_attention": {"type": "string", "enum": ["isolated", "allowed", "model_default"]}
      }
    },
    "update_order_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "seed", "algorithm", "preserves_within_context_order"],
      "properties": {
        "mode": {"type": "string", "enum": ["canonical", "global_shuffle", "custom"]},
        "seed": {"type": ["integer", "null"], "minimum": 0},
        "algorithm": {"type": "string", "minLength": 1},
        "preserves_within_context_order": {"type": "boolean"}
      }
    },
    "relationship_visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exposed_edge_ids", "withheld_edge_ids"],
      "properties": {
        "exposed_edge_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/edge_id"}, "uniqueItems": true},
        "withheld_edge_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/edge_id"}, "uniqueItems": true}
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_training_approval", "requires_redistribution_approval", "included_source_ids", "decision_log_hash"],
      "properties": {
        "requires_training_approval": {"type": "boolean"},
        "requires_redistribution_approval": {"type": "boolean"},
        "included_source_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/source_id"}, "uniqueItems": true},
        "decision_log_hash": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/export_item"},
      "minItems": 1
    },
    "token_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unique_payload_tokens", "exposure_tokens", "emitted_tokens", "excluded_tokens", "by_material_class"],
      "properties": {
        "unique_payload_tokens": {"type": "integer", "minimum": 0},
        "exposure_tokens": {"type": "integer", "minimum": 0},
        "emitted_tokens": {"type": "integer", "minimum": 0},
        "excluded_tokens": {"type": "integer", "minimum": 0},
        "by_material_class": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_authored", "external_source", "artifact", "metadata_only", "derived"],
          "properties": {
            "project_authored": {"type": "integer", "minimum": 0},
            "external_source": {"type": "integer", "minimum": 0},
            "artifact": {"type": "integer", "minimum": 0},
            "metadata_only": {"type": "integer", "minimum": 0},
            "derived": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "relative_path", "byte_count", "content_hash"],
      "properties": {
        "format": {"type": "string", "enum": ["text", "jsonl", "token_ids", "indexed_binary"]},
        "relative_path": {"type": "string", "minLength": 1},
        "byte_count": {"type": "integer", "minimum": 0},
        "content_hash": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "manifest_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "export_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_position", "optimizer_position", "context_group_id", "stream_item_id", "node_id", "payload_hash", "material_class", "exposure_index", "derived_payload_id", "token_start", "token_end", "token_count"],
      "properties": {
        "output_position": {"type": "integer", "minimum": 0},
        "optimizer_position": {"type": "integer", "minimum": 0},
        "context_group_id": {"type": "string", "pattern": "^ctx_[a-z0-9][a-z0-9_-]*$"},
        "stream_item_id": {"$ref": "common.schema.json#/$defs/stream_item_id"},
        "node_id": {"$ref": "common.schema.json#/$defs/node_id"},
        "payload_hash": {"$ref": "common.schema.json#/$defs/sha256"},
        "material_class": {"type": "string", "enum": ["project_authored", "external_source", "artifact", "metadata_only", "derived"]},
        "exposure_index": {"type": "integer", "minimum": 0},
        "derived_payload_id": {
          "oneOf": [
            {"type": "string", "pattern": "^derived_[a-z0-9][a-z0-9_-]*$"},
            {"type": "null"}
          ]
        },
        "token_start": {"type": "integer", "minimum": 0},
        "token_end": {"type": "integer", "minimum": 0},
        "token_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
