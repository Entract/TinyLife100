{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life100.local/schemas/reading_event.schema.json",
  "title": "LIFE100 Reading Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reading_event_id", "source_id", "segment_ids", "trigger", "knowledge_before",
    "intended_roles", "status"
  ],
  "properties": {
    "reading_event_id": {"type": "string", "pattern": "^read_[A-Za-z0-9_-]+$"},
    "source_id": {"type": "string"},
    "segment_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "trigger": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "episode_id": {"type": ["string", "null"]},
        "project_id": {"type": ["string", "null"]},
        "person_id": {"type": ["string", "null"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "knowledge_before": {
      "type": "object",
      "properties": {
        "known_concept_ids": {"type": "array", "items": {"type": "string"}},
        "uncertain_concept_ids": {"type": "array", "items": {"type": "string"}},
        "unknown_concept_ids": {"type": "array", "items": {"type": "string"}},
        "belief_summary": {"type": ["string", "null"]}
      }
    },
    "intended_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "first_exposure", "formalization", "vocabulary_acquisition", "problem_resolution",
          "alternative_view", "deepening", "ordinary_reading", "style_breadth", "rereading", "reference_use"
        ]
      },
      "minItems": 1
    },
    "expected_effects": {"type": "array", "items": {"type": "string"}},
    "misconceptions_expected_or_allowed": {"type": "array", "items": {"type": "string"}},
    "reflection_episode_ids": {"type": "array", "items": {"type": "string"}},
    "application_episode_ids": {"type": "array", "items": {"type": "string"}},
    "later_callback_ids": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["planned", "accepted", "completed", "abandoned", "superseded"]},
    "content_hash": {"type": ["string", "null"]}
  }
}
